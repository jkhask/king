{
  "name": "@dr/bot",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "register-commands": "node --import tsx src/register-commands.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.700.0",
    "@dr/db": "workspace:*",
    "@dr/shared": "workspace:*",
    "discord-api-types": "^0.37.108"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
