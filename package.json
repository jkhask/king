{
  "name": "diminishing-returns",
  "version": "0.1.0",
  "private": true,
  "description": "Diminishing Returns (Alliance) Guild Logistics Discord Bot & AWS CDK Stack for World of Warcraft: Forever",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "register-commands": "pnpm --filter @dr/bot register-commands",
    "cdk:synth": "pnpm --filter @dr/infra synth",
    "cdk:deploy": "pnpm --filter @dr/infra deploy",
    "cdk:diff": "pnpm --filter @dr/infra diff"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
